#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# 确保 dist 是最新的
echo "🔍 Checking if dist is up to date..."
npm run package

# 检查是否有未提交的 dist 更改
if ! git diff --quiet dist/; then
  echo "❌ Error: dist/ is not up to date!"
  echo "Please commit the updated dist/ directory"
  exit 1
fi

echo "✅ Pre-push checks passed!"
